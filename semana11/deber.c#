using System;
using System.Collections.Generic;
using System.Text.RegularExpressions;

class Program
{
    static void Main()
    {
        // Diccionario base (Inglés -> Español)
        var enToEs = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            {"time","tiempo"},
            {"person","persona"},
            {"year","año"},
            {"way","camino"},
            {"day","día"},
            {"thing","cosa"},
            {"man","hombre"},
            {"world","mundo"},
            {"life","vida"},
            {"hand","mano"},
            {"part","parte"},
            {"child","niño"},
            {"eye","ojo"},
            {"woman","mujer"},
            {"place","lugar"},
            {"work","trabajo"},
            {"week","semana"},
            {"case","caso"},
            {"point","punto"},
            {"government","gobierno"},
            {"company","empresa"}
        };

        // Diccionario inverso (Español -> Inglés) para traducir en ambos sentidos
        var esToEn = BuildReverse(enToEs);

        while (true)
        {
            Console.WriteLine("\n==================== MENÚ ====================");
            Console.WriteLine("1. Traducir una frase");
            Console.WriteLine("2. Agregar palabras al diccionario");
            Console.WriteLine("0. Salir");
            Console.Write("Seleccione una opción: ");
            string option = Console.ReadLine()?.Trim() ?? "";

            if (option == "0")
            {
                Console.WriteLine("Saliendo...");
                break;
            }
            else if (option == "1")
            {
                TranslateMenu(enToEs, esToEn);
            }
            else if (option == "2")
            {
                AddWordMenu(enToEs, esToEn);
            }
            else
            {
                Console.WriteLine("Opción inválida. Intente de nuevo.");
            }
        }
    }

    static Dictionary<string, string> BuildReverse(Dictionary<string, string> enToEs)
    {
        var esToEn = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var kv in enToEs)
        {
            // Si hay repetidos, el último sobrescribe. Para este ejercicio está bien.
            esToEn[kv.Value] = kv.Key;
        }
        return esToEn;
    }

    static void TranslateMenu(Dictionary<string, string> enToEs, Dictionary<string, string> esToEn)
    {
        Console.WriteLine("\nElige dirección de traducción:");
        Console.WriteLine("1) Inglés -> Español");
        Console.WriteLine("2) Español -> Inglés");
        Console.Write("Opción: ");
        string dir = Console.ReadLine()?.Trim() ?? "";

        Console.Write("\nIngrese una frase: ");
        string phrase = Console.ReadLine() ?? "";

        string translated = dir == "2"
            ? TranslatePhrase(phrase, esToEn)
            : TranslatePhrase(phrase, enToEs);

        Console.WriteLine("\nTraducción (parcial): " + translated);
    }

    static void AddWordMenu(Dictionary<string, string> enToEs, Dictionary<string, string> esToEn)
    {
        Console.Write("\nIngrese palabra en INGLÉS: ");
        string en = (Console.ReadLine() ?? "").Trim();

        Console.Write("Ingrese traducción en ESPAÑOL: ");
        string es = (Console.ReadLine() ?? "").Trim();

        if (string.IsNullOrWhiteSpace(en) || string.IsNullOrWhiteSpace(es))
        {
            Console.WriteLine("No se permiten campos vacíos.");
            return;
        }

        // Guardar en ambos diccionarios
        enToEs[en] = es;
        esToEn[es] = en;

        Console.WriteLine($"Guardado: {en} -> {es}");
    }

    static string TranslatePhrase(string input, Dictionary<string, string> dict)
    {
        // Separa tokens preservando palabras y signos:
        // - Palabras (incluye letras con acentos) y números: [\p{L}\p{N}]+
        // - Todo lo demás (espacios, signos, etc.) se conserva igual
        var parts = Regex.Matches(input, @"[\p{L}\p{N}]+|[^\p{L}\p{N}]+");

        var result = new System.Text.StringBuilder();

        foreach (Match m in parts)
        {
            string token = m.Value;

            // Si es palabra/número, intentar traducir
            if (Regex.IsMatch(token, @"^[\p{L}\p{N}]+$"))
            {
                if (dict.TryGetValue(token, out string translated))
                {
                    result.Append(ApplyCaseStyle(token, translated));
                }
                else
                {
                    result.Append(token);
                }
            }
            else
            {
                // Signos/espacios tal cual
                result.Append(token);
            }
        }

        return result.ToString();
    }

    static string ApplyCaseStyle(string original, string translated)
    {
        // Mantener estilo de mayúsculas:
        // - TODO MAYÚSCULAS
        // - Primera letra mayúscula (Title Case simple)
        // - Minúsculas
        if (string.IsNullOrEmpty(original) || string.IsNullOrEmpty(translated))
            return translated;

        bool allUpper = original.ToUpper() == original;
        bool allLower = original.ToLower() == original;
        bool firstUpper = char.IsLetter(original[0]) && char.IsUpper(original[0]);

        if (allUpper) return translated.ToUpper();
        if (allLower) return translated.ToLower();

        if (firstUpper)
        {
            // Capitalizar traducción
            string low = translated.ToLower();
            return char.ToUpper(low[0]) + low.Substring(1);
        }

        return translated;
    }
}
